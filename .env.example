# --- Site ---
NEXT_PUBLIC_SITE_URL=

# Maintenance gate. 'true' reroutes every public page to /under-construction
# (API routes + /studio stay reachable). Unset/'false' = normal routing.
UNDER_CONSTRUCTION=false

# Home-page promotions signup section. Renders only when exactly 'true'.
PROMOTIONS_SIGNUP_ENABLED=false

# ---------------------------------------------------------------------------
# Stripe — DEV_* (sandbox) and PROD_* (live). lib/stripeEnv.ts picks DEV_*
# when VERCEL_ENV !== 'production' (local dev + Vercel Preview/Development),
# PROD_* on Vercel Production. On Vercel, set DEV_STRIPE_* in Preview +
# Development envs and PROD_STRIPE_* in Production.
# ---------------------------------------------------------------------------
DEV_STRIPE_SECRET_KEY=
DEV_STRIPE_WEBHOOK_SECRET=
PROD_STRIPE_SECRET_KEY=
PROD_STRIPE_WEBHOOK_SECRET=

# 4-pack list prices: $8/$9/$10/$12 wash · 4-pack ($32/$36/$40/$48 total).
# The pack-discount coupon is auto-applied at checkout for $5 off (so customers
# pay $27/$31/$35/$43). During the Father's Day sale window, the Father's Day
# coupon stands in for the combined $10 off.
DEV_STRIPE_PRICE_PACK_8=
DEV_STRIPE_PRICE_PACK_9=
DEV_STRIPE_PRICE_PACK_10=
DEV_STRIPE_PRICE_PACK_12=
PROD_STRIPE_PRICE_PACK_8=
PROD_STRIPE_PRICE_PACK_9=
PROD_STRIPE_PRICE_PACK_10=
PROD_STRIPE_PRICE_PACK_12=

# Single-token prices: $8/$9/$10/$12 wash · single token.
DEV_STRIPE_PRICE_SINGLE_8=
DEV_STRIPE_PRICE_SINGLE_9=
DEV_STRIPE_PRICE_SINGLE_10=
DEV_STRIPE_PRICE_SINGLE_12=
PROD_STRIPE_PRICE_SINGLE_8=
PROD_STRIPE_PRICE_SINGLE_9=
PROD_STRIPE_PRICE_SINGLE_10=
PROD_STRIPE_PRICE_SINGLE_12=

# Always-on $5-off 4-pack discount — auto-applied to every pack-mode checkout.
# Singles do not receive it.
DEV_STRIPE_COUPON_PACK_DISCOUNT=
PROD_STRIPE_COUPON_PACK_DISCOUNT=

# Father's Day 2026 sale — $10 off 4-packs. Auto-replaces the pack discount
# for pack checkouts from 2026-06-07 00:00:00 through 2026-06-21 23:59:59
# America/Chicago (window enforced by lib/salesSchedule.ts).
DEV_STRIPE_COUPON_FATHERS_DAY_2026=
PROD_STRIPE_COUPON_FATHERS_DAY_2026=

# Labor Day 2026 sale — $10 off 4-packs. Auto-replaces the pack discount for
# pack checkouts from 2026-08-19 00:00:00 through 2026-09-07 23:59:59
# America/Chicago (window enforced by lib/salesSchedule.ts).
# REQUIRED before the window opens: without it the sale falls back to the
# always-on $5 coupon while the banner still advertises "extra $5 off".
DEV_STRIPE_COUPON_LABOR_DAY_2026=
PROD_STRIPE_COUPON_LABOR_DAY_2026=

# ---------------------------------------------------------------------------
# Email (Resend) — owner sale notifications sent from the stripe-webhook on
# checkout.session.completed. If RESEND_API_KEY is unset the webhook still
# returns 200 and just logs a warning (no email).
# ---------------------------------------------------------------------------
# Real key belongs only in .env.local (gitignored) — never commit it here.
RESEND_API_KEY=
# Verified Resend sender. Until a domain is verified, Resend only allows
# onboarding@resend.dev. Format: "Spotless Car Wash <orders@spotlessautowash.com>"
EMAIL_FROM=info@spotlessautowash.com
# Where sale notifications go. Defaults to joe@spotlessautowash.com if unset.
OWNER_NOTIFICATION_EMAIL=joe@spotlessautowash.com
# Dev/preview override: outside Vercel Production, notifications go here instead
# so test purchases don't email the real owner. Falls back to the prod value.
DEV_OWNER_NOTIFICATION_EMAIL=

# ---------------------------------------------------------------------------
# Supabase — customer + order persistence from the stripe-webhook on
# checkout.session.completed. Server-only (service-role key); if the active
# pair is unset the webhook skips persistence, logs a warning, and still 200s.
#
# Mirrors the Stripe PROD_/DEV_ split: PROD_* is used ONLY on Vercel Production,
# so the production tables are only ever written to from production. Preview +
# local dev write to the DEV_* project instead. Service-role keys are secret —
# real values belong ONLY in .env.local (gitignored) and the deploy env.
# ---------------------------------------------------------------------------
# Secret keys (sb_secret_… / legacy service_role JWT) bypass RLS and are what
# the webhook needs to write. A publishable/anon key will NOT work (RLS blocks
# it). Real secret values belong ONLY in .env.local (gitignored) — never here.
# Production project: spotless-customers
PROD_SUPABASE_URL=https://cqvrttglajxfvhxmqcvk.supabase.co
PROD_SUPABASE_SECRET_KEY=
# Dev/preview project: spotless-customers-dev
DEV_SUPABASE_URL=https://etomasuqljisemfsxlvc.supabase.co
DEV_SUPABASE_SECRET_KEY=


# --- Sanity ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
SANITY_WEBHOOK_SECRET=
SANITY_API_READ_TOKEN=
SANITY_WRITE_TOKEN=
